{
  "manifest_version": 3,
  "name": "Digital Deception Detection Suite",
  "version": "2.0",
  "description": "Detects phishing, scams, and suspicious links in messaging apps — fully in-browser, no server required.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://safebrowsing.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://web.telegram.org/*",
        "https://discord.com/channels/*",
        "https://app.slack.com/*",
        "https://messenger.com/*",
        "https://www.messenger.com/*"
      ],
      "js": ["content.js", "messaging-text-capture.js", "url-checker.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["model/model_data.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
