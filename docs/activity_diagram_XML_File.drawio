        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% -------------------------------------\n    %% STYLING CLASSES\n    %% -------------------------------------\n    classDef syncBar fill:#000,stroke:#000,height:8px;\n    classDef userNode fill:#E1D5E7,stroke:#9673A6,stroke-width:1px,color:#000;\n    classDef extNode fill:#DAE8FC,stroke:#6C8EBF,stroke-width:1px,color:#000;\n    classDef sysNode fill:#D5E8D4,stroke:#82B366,stroke-width:1px,color:#000;\n    classDef analyzeNode fill:#FFF2CC,stroke:#D6B656,stroke-width:1px,color:#000;\n    classDef dbNode fill:#F8CECC,stroke:#B85450,stroke-width:1px,color:#000;\n    classDef noteNode fill:#FFFFFF,stroke:#6C8EBF,stroke-width:1px,stroke-dasharray: 5 5,color:#333;\n\n    subgraph UserPartition [User]\n        direction TB\n        Start(( )) --&gt; OpenApp[Open Digital Deception\\nDetection Suite]:::userNode\n        OpenApp --&gt; InstallExt[Install &amp; Enable\\nBrowser Extension]:::userNode\n        InstallExt --&gt; SelectContent[In Chat Platform\\nSelect message / URL /\\nMedia to analyze]:::userNode\n        SelectContent --&gt; Wait[ ]:::userNode\n        ViewRisk[View Risk Score,\\nExplanation &amp;\\nRecommendations]:::userNode\n        ViewHistory[View History / Reports\\n(Optional)]:::userNode\n        EndNode((( )))\n        ViewRisk --&gt; EndNode\n    end\n\n    subgraph ExtPartition [Browser Extension]\n        direction TB\n        ExtNote[Extension runs on\\nuser browser/chat web]:::noteNode\n        CaptureContent[Capture Selected Content\\nfrom Chat]:::extNode\n        ExtractInfo[Extract Information\\nURL, Sender, Timestamp]:::extNode\n        SendWebApp[Send to Web App\\nSecure API Call]:::extNode\n        CaptureContent --&gt; ExtractInfo --&gt; SendWebApp\n    end\n\n    subgraph WebPartition [Web Interface]\n        direction TB\n        ReceiveData[Receive data from\\nExtension]:::extNode\n        Validate[Validate &amp; Sanitize\\nInput]:::extNode\n        ShowLoading[Show Loading /\\nProcessing Status]:::extNode\n        DisplayResults[Display Results\\nRisk Score &amp; Evidence]:::extNode\n        StoreHistory[Store to History]:::extNode\n        ReceiveData --&gt; Validate --&gt; ShowLoading\n    end\n\n    subgraph SysPartition [System Application Server]\n        direction TB\n        Route[Route request to\\nappropriate analyzers]:::sysNode\n        Decision{What type\\nof content?}:::sysNode\n        Aggregate[Aggregate sub-scores &amp;\\ncompute risk score]:::sysNode\n        Generate[Generate Explanation\\n&amp; Recommendations]:::sysNode\n        ReturnResults[Return Results to\\nWeb Interface]:::sysNode\n        Route --&gt; Decision\n        Aggregate --&gt; Generate --&gt; ReturnResults\n    end\n\n    subgraph AnalyzerPartition [Analyzer Services]\n        direction TB\n        ForkBar[ ]:::syncBar\n        TextAnalyzer[Text Analyzer\\nPhishing Detection]:::analyzeNode\n        URLAnalyzer[URL Analyzer\\nLink Risk Assessment]:::analyzeNode\n        MediaAnalyzer[Media Analyzer\\nDeepfake Detection]:::analyzeNode\n        JoinBar[ ]:::syncBar\n        ReturnSubScores[Return Sub-scores\\n&amp; Evidence]:::analyzeNode\n        \n        Decision -- \&quot;Text\&quot; --&gt; ForkBar\n        Decision -- \&quot;URL\&quot; --&gt; ForkBar\n        Decision -- \&quot;Media\&quot; --&gt; ForkBar\n        ForkBar --&gt; TextAnalyzer\n        ForkBar --&gt; URLAnalyzer\n        ForkBar --&gt; MediaAnalyzer\n        TextAnalyzer --&gt; JoinBar\n        URLAnalyzer --&gt; JoinBar\n        MediaAnalyzer --&gt; JoinBar\n        JoinBar --&gt; ReturnSubScores\n    end\n\n    subgraph DBPartition [Databases &amp; Threat Intel]\n        direction TB\n        ThreatFeeds[Threat Intelligence Feeds\\nReputation &amp; Blacklists]:::dbNode\n        SaveLog[Save Scan Log to DB]:::dbNode\n        RetrieveHistory[Retrieve History / Logs]:::dbNode\n        ThreatFeeds -.-&gt; URLAnalyzer\n        ThreatFeeds -.-&gt; MediaAnalyzer\n    end\n\n    %% Cross-Swimlane Connectors\n    InstallExt -.-&gt; CaptureContent\n    SendWebApp --&gt; ReceiveData\n    ShowLoading --&gt; Route\n    ReturnSubScores --&gt; Aggregate\n    ReturnResults --&gt; DisplayResults\n    DisplayResults --&gt; ViewRisk\n    DisplayResults --&gt; StoreHistory\n    StoreHistory --&gt; SaveLog\n    ViewHistory --&gt; RetrieveHistory\n    RetrieveHistory --&gt; EndNode&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="acKt3eIoAL0gMJk2aM5H-332">
